# Agent2API 部署配置（docker compose 自动读取本文件）。
# 全部留空即可正常部署：启动后打开面板，首次会提示注册管理员账号。

# 面板管理员：留空 = 启动后在面板注册（推荐）；填了 = 跳过注册，用这里的账号登录。
AGENT2API_ADMIN_USER=
# 密码直接填明文（启动时自动转成 bcrypt 哈希，库里只存哈希）。
AGENT2API_ADMIN_PASSWORD=

# 面板分端口：留空 = 面板与网关同端口；填了（如 3066）= 面板单独监听该端口，
# 主端口只保留 /v1 网关 —— 公网只映射主端口，即可把面板留在内网。
AGENT2API_PANEL_PORT=

# 登录页人机验证组件环境变量，默认为1开启，0为关闭
AGENT2API_CAPTCHA_ENABLED=1

# 容器内更新：默认 1 开启 —— 面板「设置 → 软件更新」里可以直接下载新版本并
# 原地替换容器内的程序与界面（替换后重启服务，容器由 restart 策略拉起）。
# 置 0 关闭该入口，之后只能按 README「升级」一节手动升级。
AGENT2API_SELF_UPDATE=1

# ── Cloudflare Tunnel（可选）──────────────────────────────────
# 置 1 开启：启动后自动按平台下载 cloudflared 并以子进程方式拉起隧道，
# 随网关停机一起退出。默认关。
AGENT2API_CLOUDFLARED_ENABLED=
# 具名隧道的 token（Cloudflare Zero Trust 控制台 → Networks → Tunnels →
# 创建 Tunnel 后给的那串）。设置后走指定隧道（域名路由在控制台配）；
# 留空走 Quick Tunnel 临时隧道（地址随机、重启会变，仅试用用）。
AGENT2API_CLOUDFLARED_TOKEN=
# 隧道转发到的本机服务地址；留空 = 转发给本网关自身（http://127.0.0.1:3065）。
AGENT2API_CLOUDFLARED_URL=
# 已有 cloudflared 可执行文件的路径；设置后跳过下载（离线环境用）。
AGENT2API_CLOUDFLARED_BIN=
# 钉住的 cloudflared 版本号（如 2026.11.2）；留空 = latest。
AGENT2API_CLOUDFLARED_VERSION=
# 追加给 cloudflared 的原始参数（空格分隔，双引号可包含空格的参数）。
AGENT2API_CLOUDFLARED_ARGS=
